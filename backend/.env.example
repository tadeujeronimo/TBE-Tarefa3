# Credenciais usadas pelo docker-compose.yml para subir o PostgreSQL
POSTGRES_USER=editais_user
POSTGRES_PASSWORD=editais_pass
POSTGRES_DB=catalogo_editais

# String de conexão usada pelo Prisma (aponta para o Postgres do Docker acima)
DATABASE_URL="postgresql://editais_user:editais_pass@localhost:5432/catalogo_editais?schema=public"

# Porta da API
PORT=3333

# Origem do front-end liberada no CORS (Vite roda em 5173 por padrão)
ALLOWED_ORIGIN=http://localhost:5173

# Segredo usado para assinar os tokens JWT (troque por um valor longo e aleatório).
# Sugestão para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Validade do token (ex.: 15m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Administrador criado/atualizado pelo "npm run seed". Só ele cria/edita/exclui editais.
# Cadastros feitos pelo site/API nascem sempre como ALUNO. Senha de DESENVOLVIMENTO: troque-a se for publicar o projeto.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
