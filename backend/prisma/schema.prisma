// Schema Prisma - Sistema de Monitorias

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Status possíveis de um edital de monitoria
enum StatusEdital {
  ABERTO
  ENCERRADO
}

model Edital {
  id                Int          @id @default(autoincrement())

  // "title" do enunciado -> disciplina ofertada na monitoria
  disciplina        String       @map("title")

  // "description" do enunciado -> descrição/detalhes do edital
  descricao         String       @db.Text @map("description")

  // "imageUrl" do enunciado -> imagem/banner do edital (caminho ou URL)
  imageUrl          String       @map("image_url")

  professor         String
  curso             String
  vagas             Int
  dataAbertura      DateTime     @map("data_abertura")
  dataEncerramento  DateTime     @map("data_encerramento")
  status            StatusEdital @default(ABERTO)
  destaque          Boolean      @default(false)

  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("editais")
}

// Papel do usuário: ALUNO (padrão) se inscreve em monitorias; ADMIN gerencia editais
enum Role {
  ALUNO
  ADMIN
}

// Usuário da aplicação (autenticação com e-mail + senha com hash bcrypt)
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ALUNO)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
